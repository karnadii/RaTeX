---
interface Props {
  defaultLatex?: string;
  msgLoading?: string;
  msgEnterLatexAbove?: string;
  msgRendering?: string;
  msgReady?: string;
  msgCopied?: string;
  msgUnavailable?: string;
  labelPlayground?: string;
  labelInput?: string;
  labelOutput?: string;
  labelExamples?: string;
  labelMathExample?: string;
  labelChemistryExample?: string;
  labelMatrixExample?: string;
  labelClear?: string;
  labelCopy?: string;
  labelRender?: string;
  labelCharacters?: string;
  shortcutHint?: string;
}

const {
  defaultLatex = String.raw`\int_{-\infty}^{\infty} e^{-x^2}\,dx = \sqrt{\pi}`,
  msgLoading = "Loading\u2026",
  msgEnterLatexAbove = "Enter LaTeX above.",
  msgRendering = "Rendering\u2026",
  msgReady = "Ready",
  msgCopied = "Copied",
  msgUnavailable = "The WebAssembly demo is unavailable in this environment.",
  labelPlayground = "Live LaTeX playground",
  labelInput = "LaTeX input",
  labelOutput = "RaTeX output",
  labelExamples = "Examples",
  labelMathExample = "Math",
  labelChemistryExample = "Chemistry",
  labelMatrixExample = "Matrix",
  labelClear = "Clear",
  labelCopy = "Copy",
  labelRender = "Render",
  labelCharacters = "characters",
  shortcutHint = "\u2318 / Ctrl + Enter to render",
} = Astro.props;

const examples = [
  {
    label: labelMathExample,
    latex: String.raw`\int_{-\infty}^{\infty} e^{-x^2}\,dx = \sqrt{\pi}`,
  },
  {
    label: labelChemistryExample,
    latex: String.raw`\ce{CO2 + C -> 2 CO} \qquad \pu{1.5e-3 mol//L}`,
  },
  {
    label: labelMatrixExample,
    latex: String.raw`A = \begin{pmatrix} a & b \\ c & d \end{pmatrix}`,
  },
];

const base = import.meta.env.BASE_URL;
---

<div
  class="hero-playground overflow-hidden rounded-2xl border border-zinc-200/90 bg-white shadow-2xl ring-1 ring-black/5"
  aria-label={labelPlayground}
  data-msg-loading={msgLoading}
  data-msg-enter={msgEnterLatexAbove}
  data-msg-rendering={msgRendering}
  data-msg-ready={msgReady}
  data-msg-copied={msgCopied}
  data-msg-unavailable={msgUnavailable}
  data-label-render={labelRender}
  data-label-characters={labelCharacters}
>
  <div class="bg-zinc-950 px-4 pb-4 pt-3.5 sm:px-5">
    <div class="mb-3 flex items-center justify-between gap-3">
      <label
        for="hero-playground-input"
        class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-zinc-400"
      >
        {labelInput}
      </label>
      <div class="flex items-center gap-1">
        <button
          id="hero-playground-clear"
          type="button"
          class="rounded-md px-2 py-1 font-mono text-[10px] text-zinc-400 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-400"
        >
          {labelClear}
        </button>
        <button
          id="hero-playground-copy"
          type="button"
          class="rounded-md px-2 py-1 font-mono text-[10px] text-zinc-400 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-400"
        >
          {labelCopy}
        </button>
      </div>
    </div>

    <textarea
      id="hero-playground-input"
      class="block min-h-[7rem] w-full resize-y rounded-xl border border-zinc-700 bg-zinc-900 px-3.5 py-3 font-mono text-[13px] leading-relaxed text-zinc-100 caret-orange-400 outline-none transition-colors placeholder:text-zinc-600 focus:border-orange-400/80 focus:ring-2 focus:ring-orange-400/15"
      rows="4"
      spellcheck="false"
      autocomplete="off"
      autocapitalize="off"
      aria-describedby="hero-playground-hint">{defaultLatex}</textarea
    >

    <div class="mt-3 flex flex-wrap items-center gap-2" aria-label={labelExamples}>
      <span class="mr-0.5 font-mono text-[10px] uppercase tracking-wider text-zinc-500">{labelExamples}</span>
      {
        examples.map((example) => (
          <button
            type="button"
            class="hero-playground-example rounded-full border border-zinc-700 bg-zinc-900 px-2.5 py-1 font-mono text-[10px] text-zinc-300 transition-colors hover:border-orange-400/60 hover:text-orange-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-400"
            data-latex={example.latex}
          >
            {example.label}
          </button>
        ))
      }
    </div>

    <div id="hero-playground-hint" class="mt-3 flex items-center justify-between gap-4 font-mono text-[10px] text-zinc-500">
      <span>{shortcutHint}</span>
      <span id="hero-playground-count" aria-live="polite"></span>
    </div>
  </div>

  <div class="border-t border-zinc-200 bg-white px-4 pb-4 pt-3.5 sm:px-5">
    <div class="mb-3 flex items-center justify-between gap-4">
      <div class="flex min-w-0 items-center gap-2">
        <span
          id="hero-playground-status-dot"
          class="hero-playground-status-dot h-2 w-2 shrink-0 rounded-full bg-amber-500"
          data-state="loading"
          aria-hidden="true"
        ></span>
        <p class="truncate font-mono text-[10px] uppercase tracking-[0.14em] text-zinc-500">
          <span class="text-zinc-400">{labelOutput}</span>
          <span aria-hidden="true"> · </span>
          <span id="hero-playground-status" role="status">{msgLoading}</span>
        </p>
      </div>
      <button
        id="hero-playground-render"
        type="button"
        class="shrink-0 rounded-lg bg-zinc-900 px-3 py-1.5 font-mono text-[10px] font-bold uppercase tracking-wider text-white transition-colors hover:bg-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-wait disabled:opacity-50"
      >
        {labelRender}
      </button>
    </div>

    <div class="overflow-x-auto rounded-xl border border-zinc-200 bg-zinc-50/70 shadow-inner">
      <div
        id="hero-playground-out"
        class="flex min-h-[7rem] w-fit min-w-full items-center justify-center p-5"
        aria-live="polite"
      >
        <span id="hero-playground-placeholder" class="text-xs italic text-zinc-400">{msgLoading}</span>
        <canvas id="hero-playground-canvas" class="hidden"></canvas>
      </div>
    </div>
    <p
      id="hero-playground-error"
      class="mt-2 min-h-[1rem] break-words font-mono text-xs text-red-700"
      role="alert"
    ></p>
  </div>
</div>

<style>
  .hero-playground-status-dot[data-state="loading"] {
    animation: status-pulse 1.2s ease-in-out infinite;
  }

  .hero-playground-status-dot[data-state="ready"] {
    background: #16a34a;
    animation: none;
  }

  .hero-playground-status-dot[data-state="idle"] {
    background: #a1a1aa;
    animation: none;
  }

  .hero-playground-status-dot[data-state="error"] {
    background: #dc2626;
    animation: none;
  }

  @keyframes status-pulse {
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-playground-status-dot {
      animation: none !important;
    }
  }
</style>

<script src={`${base}gallery.js`}></script>
<script is:inline>
  (function () {
    function boot() {
      var input = document.getElementById("hero-playground-input");
      var canvas = document.getElementById("hero-playground-canvas");
      var placeholder = document.getElementById("hero-playground-placeholder");
      var errEl = document.getElementById("hero-playground-error");
      var statusText = document.getElementById("hero-playground-status");
      var statusDot = document.getElementById("hero-playground-status-dot");
      var output = document.getElementById("hero-playground-out");
      var renderButton = document.getElementById("hero-playground-render");
      var clearButton = document.getElementById("hero-playground-clear");
      var copyButton = document.getElementById("hero-playground-copy");
      var count = document.getElementById("hero-playground-count");
      if (!input || !canvas || !errEl || !statusText || !statusDot || !renderButton) return;

      var container = input.closest("[data-msg-loading]");
      var messages = {
        enter: (container && container.dataset.msgEnter) || "Enter LaTeX above.",
        rendering: (container && container.dataset.msgRendering) || "Rendering\u2026",
        ready: (container && container.dataset.msgReady) || "Ready",
        copied: (container && container.dataset.msgCopied) || "Copied",
        unavailable:
          (container && container.dataset.msgUnavailable) ||
          "The WebAssembly demo is unavailable in this environment.",
        render: (container && container.dataset.labelRender) || "Render",
        characters: (container && container.dataset.labelCharacters) || "characters",
      };

      var timer = null;
      var renderSequence = 0;
      var copyStatusTimer = null;

      function setStatus(message, state) {
        statusText.textContent = message;
        statusDot.dataset.state = state;
      }

      function updateCount() {
        if (count) count.textContent = input.value.length + " " + messages.characters;
      }

      function setEmptyState() {
        renderSequence += 1;
        errEl.textContent = "";
        if (placeholder) {
          placeholder.classList.remove("hidden");
          placeholder.textContent = messages.enter;
        }
        canvas.classList.add("hidden");
        renderButton.disabled = true;
        renderButton.textContent = messages.render;
        if (output) output.setAttribute("aria-busy", "false");
        setStatus(messages.enter, "idle");
      }

      async function render() {
        if (timer) clearTimeout(timer);
        timer = null;
        if (copyStatusTimer) clearTimeout(copyStatusTimer);
        var latex = input.value.trim();
        if (!latex) {
          setEmptyState();
          return;
        }

        var sequence = ++renderSequence;
        errEl.textContent = "";
        renderButton.disabled = true;
        renderButton.textContent = messages.rendering;
        if (output) output.setAttribute("aria-busy", "true");
        setStatus(messages.rendering, "loading");

        if (
          typeof window.RaTeXGallery === "undefined" ||
          !window.RaTeXGallery.ensurePlaygroundEngine
        ) {
          errEl.textContent = messages.unavailable;
          setStatus(messages.unavailable, "error");
          renderButton.disabled = false;
          renderButton.textContent = messages.render;
          if (output) output.setAttribute("aria-busy", "false");
          return;
        }

        try {
          var engine = await window.RaTeXGallery.ensurePlaygroundEngine();
          if (sequence !== renderSequence) return;
          if (!engine.renderLatex) throw new Error(messages.unavailable);

          var displayList = JSON.parse(engine.renderLatex(latex));
          if (sequence !== renderSequence) return;
          if (placeholder) placeholder.classList.add("hidden");
          canvas.classList.remove("hidden");
          engine.drawDisplayList(displayList, canvas, engine.EM, engine.PAD);
          setStatus(messages.ready, "ready");
        } catch (error) {
          if (sequence !== renderSequence) return;
          if (placeholder) placeholder.classList.add("hidden");
          canvas.classList.add("hidden");
          var message = String(error).replace(/^.*?:\s*/, "").slice(0, 280);
          errEl.textContent = message || messages.unavailable;
          setStatus(message || messages.unavailable, "error");
        } finally {
          if (sequence === renderSequence) {
            renderButton.disabled = false;
            renderButton.textContent = messages.render;
            if (output) output.setAttribute("aria-busy", "false");
          }
        }
      }

      function scheduleRender() {
        if (timer) clearTimeout(timer);
        if (copyStatusTimer) clearTimeout(copyStatusTimer);
        renderSequence += 1;
        if (!input.value.trim()) {
          setEmptyState();
          return;
        }
        setStatus(messages.rendering, "loading");
        timer = setTimeout(render, 180);
      }

      input.addEventListener("input", function () {
        updateCount();
        scheduleRender();
      });

      input.addEventListener("keydown", function (event) {
        if (event.key === "Enter" && (event.metaKey || event.ctrlKey)) {
          event.preventDefault();
          render();
        }
      });

      renderButton.addEventListener("click", render);

      if (clearButton) {
        clearButton.addEventListener("click", function () {
          input.value = "";
          updateCount();
          setEmptyState();
          input.focus();
        });
      }

      if (copyButton) {
        copyButton.addEventListener("click", async function () {
          if (!input.value) return;
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(input.value);
            } else {
              var start = input.selectionStart;
              var end = input.selectionEnd;
              input.select();
              document.execCommand("copy");
              input.setSelectionRange(start, end);
            }
            setStatus(messages.copied, "ready");
            if (copyStatusTimer) clearTimeout(copyStatusTimer);
            copyStatusTimer = setTimeout(function () {
              if (!errEl.textContent) setStatus(messages.ready, "ready");
            }, 1400);
          } catch (error) {
            errEl.textContent = String(error).replace(/^.*?:\s*/, "").slice(0, 280);
          }
        });
      }

      container.querySelectorAll(".hero-playground-example").forEach(function (button) {
        button.addEventListener("click", function () {
          input.value = button.dataset.latex || "";
          updateCount();
          input.focus();
          render();
        });
      });

      updateCount();
      render();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }
  })();
</script>
